{
  "name": "punch-nextgen-quiz",
  "version": "2.0.0",
  "description": "Mini PUNCH NextGen Quiz & Rewards Platform: React front end, Node.js/Express API, SQLite",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n api,web -c red,blue \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js --reset",
    "test": "node --test tests/*.test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^5.4.8"
  }
}
